# Copy to .env and adjust as needed. Every value below has a working
# default — the app runs with zero external services out of the box.

# --- Mode switches ----------------------------------------------------------
# DEMO_MODE runs the entire pipeline deterministically: no external LLM
# calls, local embeddings, rule-based extraction, reproducible confidence
# scores. This is the default and the mode the seed/demo scripts assume.
DEMO_MODE=true

# LLM_MODE only takes effect when an LLM_API_KEY is actually set below AND
# LLM_PROVIDER=openai_compatible. It enables: (1) LLM adjudication for
# documents whose rule+embedding confidence lands in an uncertain band, and
# (2) generative RAG answers instead of extractive ones.
LLM_MODE=false

# --- Storage -----------------------------------------------------------------
# Default: zero-setup SQLite file, no Docker/Postgres required.
DATABASE_URL=sqlite:///./data/ecip.db
# Production-shaped alternative (requires `docker compose up postgres` or a
# real Postgres+pgvector instance, and the optional psycopg/pgvector
# packages from backend/requirements-optional.txt):
# DATABASE_URL=postgresql://ecip:ecip@localhost:5432/ecip
# VECTOR_BACKEND=pgvector

# --- Embeddings ----------------------------------------------------------------
# local_hash (default): dependency-free, deterministic, works offline.
# sentence_transformers: higher-quality local embeddings; requires
#   `pip install -r backend/requirements-optional.txt` (pulls in torch).
# openai_compatible: only used when LLM_MODE is actually active.
EMBEDDING_PROVIDER=local_hash
EMBEDDING_DIM=384

# --- LLM (OpenAI-compatible; only used when LLM_MODE=true) -------------------
LLM_PROVIDER=mock
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Confidence routing --------------------------------------------------------
CONFIDENCE_AUTO_ACCEPT=0.90
CONFIDENCE_SECONDARY_VALIDATION=0.70

# --- Hybrid retrieval / reranking weights (must not need to sum to 1, but do)
WEIGHT_SEMANTIC=0.45
WEIGHT_LEXICAL=0.25
WEIGHT_ONTOLOGY=0.20
WEIGHT_METADATA=0.10
