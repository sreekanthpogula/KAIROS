# Local dev: leave unset. Vite's dev server proxies /api to localhost:8000
# (see vite.config.ts) — no need to set this to run locally.
#
# Production (Vercel, or any static host): required. Vite bakes VITE_* vars
# in at BUILD time, so this must be set in your hosting provider's project
# settings (Vercel: Project Settings -> Environment Variables) *before*
# building — editing it after deploy has no effect until you rebuild.
# VITE_API_BASE_URL=https://your-backend.vercel.app/api
